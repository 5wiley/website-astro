---
// P5Background.astro
---

<div id="p5-bg-container"></div>

<!-- Load p5.js from CDN -->
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/p5.js/1.9.0/p5.min.js" defer></script>

<script>
  window.addEventListener('load', () => {
    const sketch = (p) => {
      let particles = [];

      p.setup = () => {
        const canvas = p.createCanvas(p.windowWidth, p.windowHeight);
        canvas.parent('p5-bg-container');
        
        // Initialize some floating particles
        for (let i = 0; i < 50; i++) {
          particles.push({
            x: p.random(p.width),
            y: p.random(p.height),
            vx: p.random(-0.5, 0.5),
            vy: p.random(-0.5, 0.5),
            size: p.random(20, 60)
          });
        }
      };

      p.draw = () => {
        // Use clear() instead of background() to keep it transparent.
        // This ensures any background colors on the body (like your orange scroll effect) remain visible!
        p.clear();
        
        p.noStroke();
        // A subtle blueish color with some transparency
        p.fill(100, 150, 200, 60);

        for (let pt of particles) {
          pt.x += pt.vx;
          pt.y += pt.vy;
          
          // Bounce off edges
          if (pt.x < 0 || pt.x > p.width) pt.vx *= -1;
          if (pt.y < 0 || pt.y > p.height) pt.vy *= -1;
          
          p.ellipse(pt.x, pt.y, pt.size);
        }
      };

      p.windowResized = () => {
        p.resizeCanvas(p.windowWidth, p.windowHeight);
      };
    };

    // Initialize the sketch in Instance Mode
    new p5(sketch);
  });
</script>

<style>
  #p5-bg-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: -1; /* Places the canvas behind your content */
    pointer-events: none; /* Allows clicks to pass through to links and text */
  }
</style>
