---
import BaseLayout from "../layouts/BaseLayout.astro";
import WipOverlay from "../components/UnderConstructionOverlay.astro";
import ProjectTiles from "../components/mono-karla/ProjectTiles.astro";
import BigHeader from "../components/mono-karla/BigHeader.astro";
import P5Background from "../components/P5Background.astro";
const profilePic = "https://via.placeholder.com/150";

// Helper function import
import { getEntry, render } from "astro:content";
import { getEntries } from "astro:content";
import { getCollection } from "astro:content";
import { config } from "astro:schema";

// Get specific entry
const aboutMeEntry = await getEntry("modules", "about-me");
if (!aboutMeEntry) {
  throw new Error("no such entry, about-me");
}

// Get project entries
const allProjects = await getCollection("projects");

// Prepare the content file to be used in the code
// const pageTitle = aboutMeEntry.data.title;
// const pageDescription = aboutMeEntry.data.description;
const { Content: AboutMe } = await render(aboutMeEntry);
---

<BaseLayout title="About Me - Tom Wiley Cotton">
  <P5Background />
  <section class="big-header">
    <BigHeader />
  </section>

  <section class="about-section">
    <h1>{aboutMeEntry.data.title}</h1>
    <p>{aboutMeEntry.data.description}</p>
    <div class="markdown-content">
      <AboutMe />
    </div>
  </section>

  <section class="project-selection">
    <h2>My Projects</h2>
    <div class="project-grid">
      {allProjects.map((project) => <ProjectTiles project={project} />)}
    </div>
  </section>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const body = document.body;
      window.addEventListener("scroll", () => {
        if (window.scrollY < 5) {
          body.classList.add("scrolled");
        } else {
          body.classList.remove("scrolled");
        }
      });
    });
  </script>
</BaseLayout>

<style>
  .project-selection {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid #eee;
  }
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
  :global(body.scrolled) {
    background-color: orange;
  }
</style>
